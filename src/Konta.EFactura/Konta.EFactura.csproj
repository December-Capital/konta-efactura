<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>Konta.EFactura</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>December Capital</Authors>
    <Description>Client for Moldova's SIA e-Factura (State Tax Service) SOAP API, with a serialiser for its invoice XML schema.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/December-Capital/konta-efactura</PackageProjectUrl>
    <RepositoryUrl>https://github.com/December-Capital/konta-efactura</RepositoryUrl>
    <PackageTags>moldova;efactura;sfs;e-invoicing;einvoicing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Konta.EFactura.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- WCF client for the generated contract in Generated/, from spec/sfs/Service.wsdl. -->
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
    <!-- The WCF packages bring 8.0.2, which has known high-severity advisories; pin a patched one. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.20" />
  </ItemGroup>

</Project>
